# The Food Fairy: copy to .env and fill in.
# Put comments on their own lines. systemd's EnvironmentFile does not
# support "VALUE  # comment" on the same line.

# ---------------------------------------------------------------- general
NODE_ENV=production
# Full site URL, no trailing slash. Used in emails, link previews and the Square redirect.
SITE_URL=https://thefoodfairy.ca
# nginx sits in front. Never expose Node directly.
HOST=
PORT=
# SQLite database + uploaded photos. BACK THIS UP.
DATA_DIR=
CLIENT_DIR=
# Defaults to true when NODE_ENV=production or SITE_URL is https.
# Only set false for local http testing.
COOKIE_SECURE=true
# true behind nginx, so rate limits see the real client IP.
TRUST_PROXY=true

# ---------------------------------------------------------------- checkout
# square_api  = per-order Square payment link with real line items + webhook (recommended)
# square_link = one static Square link; she marks orders paid by hand in admin
# disabled    = browse only
CHECKOUT_MODE=square_api

# square_api
# sandbox or production
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_VERSION=2024-10-17
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the URL in the Square dashboard EXACTLY (no trailing slash, same www or not).
SQUARE_WEBHOOK_URL=https://thefoodfairy.ca/api/webhooks/square

# square_link
SQUARE_CHECKOUT_URL=

# ---------------------------------------------------------------- email
# Leave SMTP_HOST empty in dev: emails are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=The Food Fairy <orders@thefoodfairy.ca>
# Gets new-order and catering notifications.
OWNER_EMAIL=firdaos@example.com
