{
  "name": "the-food-fairy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Food Fairy — order-first site for Nigerian food in Kitchener / Waterloo. Self-hosted: Node + SQLite, Square for payments only.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "admin:create": "node --disable-warning=ExperimentalWarning dist/server/cli/create-admin.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning dist/server/cli/seed-demo.js"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "nodemailer": "^10.0.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  }
}
